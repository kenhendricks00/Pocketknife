<UserControl x:Class="Pocketknife.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,36">
            <TextBlock Text="All tools" Style="{DynamicResource TitleTextBlockStyle}" />
            <TextBlock x:Name="Hint" Style="{StaticResource Secondary}" Margin="0,6,0,8" />
            <ItemsControl x:Name="Groups">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Text="{Binding Name}" Style="{DynamicResource BodyStrongTextBlockStyle}" Margin="2,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Tools}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="OnToolClick" Tag="{Binding}" Width="250" Height="112" Margin="0,0,10,10" Padding="16,12"
                                                HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                                                AutomationProperties.Name="{Binding Name}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18"
                                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,0"
                                                           TextTrimming="CharacterEllipsis" MaxHeight="48" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="16" Margin="0,0,12,0" />
                    <TextBlock Style="{StaticResource Secondary}" MaxWidth="760"
                               Text="Everything runs on this PC. No account, no analytics, no uploads. The only network use is Download Video and fetching an engine the first time a tool needs it." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
