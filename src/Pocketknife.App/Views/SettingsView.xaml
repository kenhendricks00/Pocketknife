<UserControl x:Class="Pocketknife.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,36" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{DynamicResource TitleTextBlockStyle}" Margin="0,0,0,18" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Output folder" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,10" Text="Every run creates a new dated folder here, so nothing is ever overwritten." />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Change…" Click="OnChangeOutput" Margin="12,0,0,0" />
                            <Button Content="Reset" Click="OnResetOutput" Margin="8,0,0,0" />
                            <Button Content="Open" Click="OnOpenOutput" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="OutputPath" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{DynamicResource BodyStrongTextBlockStyle}" Margin="0,0,0,10" />
                    <ComboBox x:Name="ThemeBox" Width="240" HorizontalAlignment="Left" SelectionChanged="OnThemeChanged" AutomationProperties.Name="Theme">
                        <ComboBoxItem Content="Use Windows setting" Tag="System" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Quick launcher" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,10" Text="Press the shortcut anywhere in Windows, type a few letters and press Enter." />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="HotkeyBox" Width="240" SelectionChanged="OnHotkeyChanged" AutomationProperties.Name="Launcher shortcut" />
                        <TextBlock x:Name="HotkeyWarning" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <CheckBox x:Name="TrayBox" Content="Keep running in the notification area when the window is closed" Margin="0,14,0,0" Click="OnTrayChanged" />
                    <CheckBox x:Name="StartupBox" Content="Start with Windows (in the notification area)" Margin="0,8,0,0" Click="OnStartupChanged" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Engines" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,8">
                        Some tools use free programs or models that are downloaded once, from pinned releases, and checked against a known SHA-256 before use.
                        You can point to your own copy instead. They are stored in <Run x:Name="EnginesPath" />.
                    </TextBlock>
                    <ItemsControl x:Name="EngineList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,10,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Download" Command="{Binding DownloadCommand}" Margin="8,0,0,0" />
                                        <Button Content="Use my own…" Command="{Binding ChooseCommand}" Margin="8,0,0,0" />
                                        <Button Content="Reset" Command="{Binding ResetCommand}" Margin="8,0,0,0" />
                                        <Button Content="Remove" Command="{Binding RemoveCommand}" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}" FontSize="12" />
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Secondary}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Privacy" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0"
                               Text="Every tool runs on this PC. There is no account, no analytics and nothing is uploaded. The network is used only by Download Video, which fetches the links you paste, and to download an engine the first time a tool needs it." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Secondary}" Margin="0,4,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="License" Click="OnLicense" />
                        <Button Content="Third-party notices" Click="OnNotices" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
