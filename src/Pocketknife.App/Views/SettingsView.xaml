<UserControl x:Class="Pocketknife.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,36" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{DynamicResource TitleTextBlockStyle}" Margin="0,0,0,18" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Output folder" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,10" Text="Every run creates a new dated folder here, so nothing is ever overwritten." />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Change…" Click="OnChangeOutput" Margin="12,0,0,0" />
                            <Button Content="Reset" Click="OnResetOutput" Margin="8,0,0,0" />
                            <Button Content="Open" Click="OnOpenOutput" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="OutputPath" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{DynamicResource BodyStrongTextBlockStyle}" Margin="0,0,0,10" />
                    <ComboBox x:Name="ThemeBox" Width="240" HorizontalAlignment="Left" SelectionChanged="OnThemeChanged" AutomationProperties.Name="Theme">
                        <ComboBoxItem Content="Use Windows setting" Tag="System" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Quick launcher" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,10" Text="Press the shortcut anywhere in Windows, type a few letters and press Enter." />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="HotkeyCapture" Width="240" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Arrow"
                                 PreviewKeyDown="OnHotkeyKeyDown" LostKeyboardFocus="OnHotkeyCaptureLost"
                                 AutomationProperties.Name="Launcher shortcut" AutomationProperties.AutomationId="HotkeyCapture" />
                        <Button Content="Change…" Click="OnChangeHotkey" Margin="8,0,0,0" AutomationProperties.AutomationId="ChangeHotkey" />
                        <Button Content="Reset" Click="OnResetHotkey" Margin="8,0,0,0" AutomationProperties.AutomationId="ResetHotkey" />
                    </StackPanel>
                    <TextBlock x:Name="HotkeyMessage" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.AutomationId="HotkeyMessage"
                               Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource VisibleWhenSet}}" />
                    <StackPanel x:Name="HotkeyConfirm" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                        <Button Content="Use it anyway" Click="OnUseHotkeyAnyway" AutomationProperties.AutomationId="UseHotkeyAnyway" />
                        <Button Content="Keep current" Click="OnKeepHotkey" Margin="8,0,0,0" AutomationProperties.AutomationId="KeepHotkey" />
                    </StackPanel>
                    <CheckBox x:Name="TrayBox" Content="Keep running in the notification area when the window is closed" Margin="0,14,0,0" Click="OnTrayChanged" />
                    <CheckBox x:Name="StartupBox" Content="Start with Windows (in the notification area)" Margin="0,8,0,0" Click="OnStartupChanged" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Web search" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,10"
                               Text="When the launcher text isn't a tool, press Enter to search the web in your browser. Pocketknife never sends what you type anywhere itself; your browser opens the search page." />
                    <CheckBox x:Name="WebEnabledBox" Content="Search the web from the launcher" Click="OnWebEnabledChanged" AutomationProperties.AutomationId="WebEnabled" />
                    <StackPanel x:Name="WebOptions" Margin="0,14,0,0">
                        <TextBlock Text="Default search engine" Margin="0,0,0,6" />
                        <ComboBox x:Name="EngineBox" Width="240" HorizontalAlignment="Left" SelectionChanged="OnEngineChanged"
                                  AutomationProperties.Name="Default search engine" />
                        <StackPanel x:Name="CustomEnginePanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Use" Click="OnUseCustomEngine" Margin="8,0,0,0" />
                                <Grid>
                                    <TextBox x:Name="CustomTemplateBox" AutomationProperties.Name="Custom search address" />
                                    <TextBlock Text="https://example.com/search?q={query}" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Visibility="{Binding Text, ElementName=CustomTemplateBox, Converter={StaticResource VisibleWhenEmpty}}" />
                                </Grid>
                            </DockPanel>
                            <TextBlock x:Name="CustomEngineMessage" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource VisibleWhenSet}}" />
                        </StackPanel>

                        <TextBlock Text="Bangs" Style="{DynamicResource BodyStrongTextBlockStyle}" Margin="0,18,0,0" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,8"
                                   Text="Type a bang anywhere in the launcher, like !yt lofi beats, to search that site. A bang on its own opens the site." />
                        <ItemsControl x:Name="BangList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Remove"
                                                Click="OnRemoveBang" Tag="{Binding Trigger}" AutomationProperties.Name="Remove bang" />
                                        <TextBlock Width="80" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <Run Text="!" /><Run Text="{Binding Trigger, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" Width="130" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Template}" Style="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Template}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Margin="0,0,6,0">
                                <TextBox x:Name="NewBangTrigger" AutomationProperties.Name="New bang shortcut" />
                                <TextBlock Text="!mdn" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding Text, ElementName=NewBangTrigger, Converter={StaticResource VisibleWhenEmpty}}" />
                            </Grid>
                            <Grid Grid.Column="1" Margin="0,0,6,0">
                                <TextBox x:Name="NewBangName" AutomationProperties.Name="New bang site name" />
                                <TextBlock Text="MDN" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding Text, ElementName=NewBangName, Converter={StaticResource VisibleWhenEmpty}}" />
                            </Grid>
                            <Grid Grid.Column="2">
                                <TextBox x:Name="NewBangTemplate" AutomationProperties.Name="New bang search address" />
                                <TextBlock Text="https://developer.mozilla.org/search?q={query}" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding Text, ElementName=NewBangTemplate, Converter={StaticResource VisibleWhenEmpty}}" />
                            </Grid>
                            <Button Grid.Column="3" Content="Add" Click="OnAddBang" Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock x:Name="BangMessage" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource VisibleWhenSet}}" />
                        <Button Content="Restore default bangs" Click="OnRestoreBangs" Margin="0,10,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Calculator" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,10"
                               Text="Type math such as 12*(3+4), 15% of 80, sqrt(2) or 255 to hex into the launcher. The answer appears as you type, and Enter copies it." />
                    <CheckBox x:Name="CalculatorBox" Content="Show calculator results in the launcher" Click="OnCalculatorChanged" AutomationProperties.AutomationId="CalculatorEnabled" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Engines" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,8">
                        Some tools use free programs or models that are downloaded once, from pinned releases, and checked against a known SHA-256 before use.
                        You can point to your own copy instead. They are stored in <Run x:Name="EnginesPath" />.
                    </TextBlock>
                    <ItemsControl x:Name="EngineList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,10,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Download" Command="{Binding DownloadCommand}" Margin="8,0,0,0" />
                                        <Button Content="Use my own…" Command="{Binding ChooseCommand}" Margin="8,0,0,0" />
                                        <Button Content="Reset" Command="{Binding ResetCommand}" Margin="8,0,0,0" />
                                        <Button Content="Remove" Command="{Binding RemoveCommand}" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource Secondary}" FontSize="12" />
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Secondary}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Privacy" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0"
                               Text="Every tool runs on this PC. There is no account, no analytics and nothing is uploaded. The network is used only by Download Video, which fetches the links you paste, and to download an engine the first time a tool needs it." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="About" Style="{DynamicResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Secondary}" Margin="0,4,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="License" Click="OnLicense" />
                        <Button Content="Third-party notices" Click="OnNotices" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
