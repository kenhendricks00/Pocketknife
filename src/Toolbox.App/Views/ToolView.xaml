<UserControl x:Class="Toolbox.App.Views.ToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Toolbox.App.ViewModels">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:ChoiceOptionViewModel}">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="{Binding Label}" Margin="0,0,0,6" />
                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label" MinWidth="280"
                          HorizontalAlignment="Left" AutomationProperties.Name="{Binding Label}" />
                <TextBlock Text="{Binding Help}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,6,0,0"
                           Visibility="{Binding Help, Converter={StaticResource VisibleWhenSet}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NumberOptionViewModel}">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="{Binding Label}" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="120" AutomationProperties.Name="{Binding Label}" />
                    <TextBlock Text="{Binding Unit}" Style="{StaticResource Secondary}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Help}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,6,0,0"
                           Visibility="{Binding Help, Converter={StaticResource VisibleWhenSet}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ToggleOptionViewModel}">
            <StackPanel Margin="0,0,0,10">
                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" AutomationProperties.Name="{Binding Label}" />
                <TextBlock Text="{Binding Help}" Style="{StaticResource Secondary}" FontSize="12" Margin="28,2,0,0"
                           Visibility="{Binding Help, Converter={StaticResource VisibleWhenSet}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TextOptionViewModel}">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="{Binding Label}" Margin="0,0,0,6" />
                <Grid>
                    <TextBox x:Name="Box" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="{Binding Multiline}"
                             TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="{Binding Label}" />
                    <TextBlock Text="{Binding Placeholder}" IsHitTestVisible="False" Margin="12,7,0,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding Text, Converter={StaticResource VisibleWhenEmpty}}" />
                </Grid>
                <TextBlock Text="{Binding Help}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,6,0,0"
                           Visibility="{Binding Help, Converter={StaticResource VisibleWhenSet}}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Multiline}" Value="True">
                    <Setter TargetName="Box" Property="MinHeight" Value="84" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,36" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="{Binding Tool.Glyph}" FontSize="26" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="{Binding Tool.Name}" Style="{DynamicResource TitleTextBlockStyle}" Margin="14,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Tool.Summary}" Style="{StaticResource Secondary}" Margin="0,6,0,18" />

            <ItemsControl ItemsSource="{Binding EngineNotes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                            <DockPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Hyperlink Click="OnOpenSettings">Use my own copy</Hyperlink>
                                </TextBlock>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Visibility="{Binding FileInput, Converter={StaticResource VisibleWhenSet}}">
                <StackPanel>
                    <Border x:Name="DropZone" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" DragLeave="OnDragLeave"
                            CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="20,22">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE898;" FontSize="28" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" FontWeight="SemiBold">
                                <Run Text="Drop" /> <Run Text="{Binding FileInput.Noun, Mode=OneWay}" /> <Run Text="or a folder here" />
                            </TextBlock>
                            <TextBlock Text="{Binding AcceptedTypes}" Style="{StaticResource Secondary}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,12" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Choose files…" Click="OnChooseFiles" AutomationProperties.AutomationId="ChooseFiles" />
                                <Button Content="Choose folder…" Click="OnChooseFolder" Margin="8,0,0,0" AutomationProperties.AutomationId="ChooseFolder" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Inputs}" Margin="0,8,0,0" AutomationProperties.AutomationId="InputList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Move up"
                                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanReorder, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisible}}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Move down"
                                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanReorder, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisible}}" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="Remove"
                                                Command="{Binding DataContext.RemoveInputCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Margin="2,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding TextInput, Converter={StaticResource VisibleWhenSet}}">
                <StackPanel>
                    <TextBlock Text="{Binding TextInput.Label}" Style="{DynamicResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                    <Grid>
                        <TextBox x:Name="TextInputBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="96" VerticalContentAlignment="Top" AutomationProperties.AutomationId="TextInput"
                                 AutomationProperties.Name="{Binding TextInput.Label}" />
                        <TextBlock Text="{Binding TextInput.Placeholder}" IsHitTestVisible="False" Margin="12,7,0,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding Text, Converter={StaticResource VisibleWhenEmpty}}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding HasOptions, Converter={StaticResource BoolToVisible}}">
                <StackPanel>
                    <TextBlock Text="Settings" Style="{DynamicResource BodyStrongTextBlockStyle}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Options}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisible}}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Left" Command="{Binding RunCommand}" Style="{DynamicResource AccentButtonStyle}" MinWidth="120" Padding="20,7"
                        AutomationProperties.AutomationId="RunButton" AutomationProperties.Name="Start">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Margin="0,0,8,0" />
                        <TextBlock Text="Start" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Content="Cancel" Command="{Binding CancelCommand}" Margin="8,0,0,0"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisible}}" AutomationProperties.AutomationId="CancelButton" />
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.AutomationId="StatusText" />
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="4" Margin="0,6,0,0"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding OutputHint}" Style="{StaticResource Secondary}" FontSize="12" Margin="0,12,0,16" />

            <Border x:Name="ResultCard" Style="{StaticResource Card}" Visibility="{Binding ResultSummary, Converter={StaticResource VisibleWhenSet}}"
                    AutomationProperties.AutomationId="ResultCard">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Command="{Binding OpenOutputCommand}" AutomationProperties.AutomationId="OpenFolderButton"
                                Visibility="{Binding OutputDirectory, Converter={StaticResource VisibleWhenSet}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Margin="0,0,8,0" />
                                <TextBlock Text="Open folder" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,16,0"
                                   AutomationProperties.AutomationId="ResultSummary" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Outputs}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding Messages, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Margin="0,10,0,0"
                             Visibility="{Binding Messages, Converter={StaticResource VisibleWhenSet}}" AutomationProperties.AutomationId="Messages" />
                </StackPanel>
            </Border>

            <Border x:Name="FailureCard" Style="{StaticResource Card}" Visibility="{Binding Failures.Count, Converter={StaticResource VisibleWhenSet}}">
                <ItemsControl ItemsSource="{Binding Failures}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{Binding Item, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Message, Mode=OneWay}" />
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
